<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Security PoC Lab</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <style>
    :root { color-scheme: dark; --bg:#10151d; --panel:#1b2430; --text:#e8edf4; --muted:#aab7c6; --accent:#75d6c2; --danger:#ff9e9e; }
    * { box-sizing:border-box } body { margin:0; font:16px/1.55 system-ui,sans-serif; background:var(--bg); color:var(--text) }
    header { padding:1rem max(1rem,calc((100vw - 1000px)/2)); background:#151d28; border-bottom:1px solid #303b49 }
    header a { color:var(--accent); text-decoration:none; margin-right:1rem; font-weight:600 }
    main { max-width:1000px; margin:2rem auto; padding:0 1rem 3rem }
    .panel { background:var(--panel); border:1px solid #303b49; border-radius:12px; padding:1.25rem; margin:1rem 0 }
    .warning { border-left:4px solid #ffb454; padding:.8rem 1rem; background:#33291d; border-radius:6px }
    .vuln { color:var(--danger); font-weight:700 } label { display:block; margin:.6rem 0 .2rem }
    input, textarea, button { font:inherit; padding:.65rem .8rem; border-radius:7px; border:1px solid #465568; width:100%; background:#0f151d; color:var(--text) }
    button { width:auto; background:#235b55; border:0; cursor:pointer; margin-top:.8rem }
    code, pre { background:#0b1016; padding:.2rem .35rem; border-radius:4px; overflow-wrap:anywhere }
    pre { padding:1rem; white-space:pre-wrap } .notice { color:var(--accent) } .alert { color:var(--danger) }
    table { width:100%; border-collapse:collapse } th,td { text-align:left; padding:.6rem; border-bottom:1px solid #3a4655 }
    a { color:var(--accent) } .muted { color:var(--muted) }
  </style>
</head>
<body>
<header>
  <a href="/">Security PoC Lab</a>
  <a href="/xss">XSS</a>
  <a href="/csrf">CSRF</a>
  <a href="/sqli">SQLi</a>
  <a href="/secure">Versões seguras</a>
</header>
<main>
  <% if flash[:notice] %><p class="notice"><%= flash[:notice] %></p><% end %>
  <% if flash[:alert] %><p class="alert"><%= flash[:alert] %></p><% end %>
  <%= yield %>
</main>
</body>
</html>
